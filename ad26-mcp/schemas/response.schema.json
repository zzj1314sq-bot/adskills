{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native AD26 response envelope",
  "type": "object",
  "required": [
    "protocol_version",
    "instance_id",
    "session_id",
    "id",
    "revision",
    "success",
    "data",
    "error"
  ],
  "properties": {
    "protocol_version": {
      "const": 26
    },
    "instance_id": {
      "const": "ad26"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "success": {
      "type": "boolean"
    },
    "data": {
      "type": [
        "object",
        "null"
      ]
    },
    "error": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "success": {
          "const": true
        },
        "data": {
          "type": "object"
        },
        "error": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "success": {
          "const": false
        },
        "data": {
          "type": "null"
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message",
            "details"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "details": {}
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
